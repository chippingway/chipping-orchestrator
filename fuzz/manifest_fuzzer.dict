# and the values the validators decide on.
open_fence="```orchestrator-manifest\x0a"
close_fence="\x0a```"
late_fence="```orchestrator-late-manifest\x0a"
backticks="```"
decision="\"decision\""
single="\"single\""
split="\"split\""
children="\"children\""
title="\"title\""
body="\"body\""
depends_on="\"depends_on\""
umbrella="\"umbrella\""
rationale="\"rationale\""
empty_list="[]"
first_child="[0]"
literal_true="true"
literal_false="false"
literal_null="null"
literal_nan="NaN"
float_zero="0.0"
negative_one="-1"
