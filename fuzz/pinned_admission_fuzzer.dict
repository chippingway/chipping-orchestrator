# Tokens of the pinned-state comment format: the markers, the terminator and its
# escape, and the version field the admission decides on.
marker="<!--orchestrator-state"
marker_space="<!--orchestrator-state "
terminator="-->"
escaped_terminator="--\\u003e"
ordinary_marker="<!--orchestrator-comment-->"
version_key="\"schema_version\""
version_one="\"schema_version\": 1"
open_object="{\"schema_version\": 1, "
quote="\""
backslash="\\"
escape_unicode="\\u"
literal_true="true"
literal_false="false"
literal_null="null"
literal_nan="NaN"
literal_infinity="Infinity"
float_one="1.0"
