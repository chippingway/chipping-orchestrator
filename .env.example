# Basic setup for `pipx install chipping-orchestrator`. Copy this file
# to ~/.config/chipping-orchestrator/.env, then edit it before launching
# `chipping-orchestrator`. Walkthrough: `docs/configuration.md`.
# Source-checkout setup is for developers: `docs/development.md`.

# Package setup appends LOG_DIR at the end of the copied file so logs
# survive pipx environment replacement. Edit that line; do not add another.
# Use an absolute path; .env does not expand $HOME or ~.

# GITHUB_TOKEN is NOT loaded from this file -- the implementer agent
# could read .env via sandbox bypass. Export it before launch, or write
# one token per REPOS entry to ~/.config/<owner>/<name>/token
# (chmod 600). Fine-grained personal access token scopes and the
# security rationale are in `docs/configuration.md`.

# REQUIRED. The repositories to manage, one entry each:
#   owner/name|target_root|base_branch[|remote_name[|parallel_limit]]
# Required fields:
#   owner/name      the GitHub repository, e.g. `acme/api`.
#   target_root     absolute path to the top of an existing local clone
#                   of it; worktrees are `git worktree add`-ed from here.
#                   `~` and `$HOME` are not expanded.
#   base_branch     the branch pull requests target, e.g. `main`.
# Optional fields, omitted together with their `|`:
#   remote_name     git remote in target_root that points at owner/name;
#                   default `origin`.
#   parallel_limit  issues this repository runs at once; default
#                   MAX_PARALLEL_ISSUES_PER_REPO (1).
# The optional fields are positional: to set parallel_limit, also write
# remote_name (`origin` keeps its default).
# Entries are separated by `;` or a newline. This file holds each value
# on one line, so here separate them with `;`, e.g. two repositories,
# the second with its own remote and two issues at once:
# REPOS=acme/api|/srv/clones/acme-api|main;acme/web|/srv/clones/acme-web|master|upstream|2
# Edit this single-repository example to name your repository and clone:
REPOS=github-user/my-project|/home/github-user/src/my-project|main

# Comma-separated GitHub logins the orchestrator @-mentions when it
# needs human attention.
HITL_HANDLE=github-user

# REQUIRED. Comma-separated GitHub logins whose unlabeled issues the
# orchestrator may auto-pick-up. The orchestrator refuses to start
# (`--once` included) while this names nobody, so set it to your own
# logins before the first run, e.g.
# ALLOWED_ISSUE_AUTHORS=github-user,chipping-orchestrator
# It is also the comment trust boundary: comments from authors outside
# the list stay visible on GitHub but are dropped from agent prompts,
# drift detection, resume signals, and PR feedback, so an outsider cannot
# steer the workflow.
ALLOWED_ISSUE_AUTHORS=

# Backend for each agent role: `codex`, `claude`, or `agy` (Antigravity), optionally followed
# by backend-CLI args. Only the backends you route to need to be
# authenticated on the host. Full spec format: `docs/workflow/command-specs.md`.
# DECOMPOSE_AGENT also runs the two labels you apply by hand: read-only
# `question`, and `discussion`, whose only write is the agreed plan the
# orchestrator publishes as a pull request for you to decide.
DEV_AGENT=claude
REVIEW_AGENT=codex
DECOMPOSE_AGENT=claude

# Nothing else is needed for a first run. Optional operational settings
# (worktree location, cadence, parallelism, local verify gate,
# analytics, observability) and the orchestrator-developer settings
# live in `.env.example.advanced` and are fully documented in
# `docs/configuration.md` and `docs/configuration/`.
